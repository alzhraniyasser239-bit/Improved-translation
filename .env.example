# ---------------------------------------------------------------------------
# Nothing here is required. With no changes the app translates for free using
# Google Translate's public endpoint (no API key).
# ---------------------------------------------------------------------------

# Optional: force an engine.
#   google-free    (default, free, no key, unofficial endpoint, personal / low-volume use)
#   libretranslate (free, open source, needs a server: see LIBRETRANSLATE_URL)
#   deepl          (needs DEEPL_API_KEY)
#   google         (official Google Cloud API, needs GOOGLE_TRANSLATE_API_KEY)
#   mock           (test mode: prefixes text with the language code)
# If you leave this out and DEEPL_API_KEY is set, DeepL is used automatically.
# TRANSLATION_PROVIDER=google-free

# DeepL (https://www.deepl.com/pro-api). Keys ending in ":fx" use the free endpoint automatically.
# DEEPL_API_KEY=

# Google Cloud Translation v2 (Basic)
# GOOGLE_TRANSLATE_API_KEY=

# LibreTranslate (your own server, or any instance)
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=

# Safety limits
MAX_UPLOAD_MB=15
MAX_TRANSLATE_CHARS=150000
